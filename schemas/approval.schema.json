{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tesseract-creative-lab.local/schemas/approval.schema.json",
  "title": "Approval gates",
  "type": "object",
  "required": ["schema_version", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "gates": {
      "type": "object",
      "required": ["storyboard", "stills", "final_preview"],
      "properties": {
        "storyboard": {"$ref": "#/$defs/gate"},
        "stills": {"$ref": "#/$defs/gate"},
        "final_preview": {"$ref": "#/$defs/gate"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["mode", "status", "approved_at", "approved_by", "actor_type", "note"],
      "properties": {
        "mode": {"enum": ["human", "auto"]},
        "status": {"enum": ["pending", "approved", "rejected"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "approved_by": {"type": ["string", "null"]},
        "actor_type": {"enum": ["human", "agent", null]},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
