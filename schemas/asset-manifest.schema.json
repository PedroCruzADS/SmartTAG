{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tesseract-creative-lab.local/schemas/asset-manifest.schema.json",
  "title": "Authorized asset manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "assets_dir", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "assets_dir": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
